# Frontend. En desarrollo se recomienda mantener /api y usar el proxy de Vite.
VITE_API_URL=/api

# API y PostgreSQL.
PORT=3001
TRUST_PROXY=
DATABASE_URL=postgresql://intranet:CAMBIAR_CLAVE@127.0.0.1:5432/intranet
DATABASE_SSL=false
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=8h
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Primer administrador. Se utilizan con: npm run db:seed
ADMIN_EMAIL=admin@empresa.cl
ADMIN_PASSWORD=CAMBIAR_CLAVE_TEMPORAL
ADMIN_NAME=Administrador General
COMPANY_NAME=Técnica Hidráulica Ltda.
COMPANY_SLUG=tecnica-hidraulica

# Solo para migrar datos y archivos desde el proyecto Supabase anterior.
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
