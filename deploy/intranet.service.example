[Unit]
Description=Intranet TH Control
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/desarrollo/intranet
EnvironmentFile=/var/www/desarrollo/intranet/.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
