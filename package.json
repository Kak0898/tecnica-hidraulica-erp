{
  "name": "tecnica-hidraulica-erp",
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "npx vite build && npx vite build --ssr worker/index.ts --outDir dist/server --emptyOutDir false",
    "test": "node --test server/*.test.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "db:schema": "node database/build-schema.mjs",
    "db:smoke": "node database/smoke-test.mjs",
    "db:init": "node database/init.mjs",
    "db:seed": "node database/seed-admin.mjs",
    "db:seed:vendedores": "node database/seed-vendedores.mjs",
    "db:seed:comprobantes": "node database/seed-comprobantes.mjs",
    "db:seed:documentos": "node database/seed-documentos.mjs",
    "db:seed:documentos-empresa": "node database/seed-documentos-empresa.mjs",
    "db:seed:hosting-credenciales": "node database/seed-hosting-credenciales.mjs",
    "db:seed:vehiculo-archivos": "node database/seed-vehiculo-archivos.mjs",
    "db:seed:eliminar-empresa-confirmada": "node database/seed-eliminar-empresa-confirmada.mjs",
    "db:seed:comisiones-importacion": "node database/seed-comisiones-importacion.mjs",
    "db:seed:ordenes-formato": "node database/seed-ordenes-formato.mjs",
    "db:migrate:supabase": "node database/migrate-from-supabase.mjs",
    "storage:migrate:supabase": "node database/migrate-storage.mjs",
    "deploy:dev": "bash deploy/update-development.sh"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "latest",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "^3.8.1",
    "tesseract.js": "^7.0.0",
    "typescript": "latest",
    "vite": "latest",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "latest",
    "postcss": "latest",
    "tailwindcss": "latest"
  }
}
